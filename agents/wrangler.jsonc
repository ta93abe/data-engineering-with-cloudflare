{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "data-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // Durable Objects — Agent は DO 上で動作する
  "durable_objects": {
    "bindings": [
      {
        "name": "DataAgent",
        "class_name": "DataAgent"
      }
    ]
  },

  // SQLite マイグレーション — ステート永続化に必要
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DataAgent"]
    }
  ],

  // Workers AI — AI Gateway 経由でログ/キャッシュ/レート制限
  "ai": {
    "binding": "AI",
    "gateway": {
      "id": "data-agent-gateway",
      "skipCache": false,
      "cacheTtl": 3600
    }
  },

  // Vectorize — RAG 用ベクトルインデックス (768次元, cosine)
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "data-agent-index"
    }
  ],

  // R2 — レポート保存 + データレイク参照
  "r2_buckets": [
    {
      "binding": "DATA_LAKE",
      "bucket_name": "data-lake"
    }
  ],

  // D1 — 既存の raw データベースに接続
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "raw",
      "database_id": "30fb49b7-8321-4792-8706-06c9205ce026"
    }
  ],

  // Cron — 日次インサイト生成 + 週次レポート
  "triggers": {
    "crons": ["0 9 * * *"]
  }

  // シークレット:
  //   wrangler secret put SLACK_BOT_TOKEN
  //   wrangler secret put SLACK_SIGNING_SECRET
}
