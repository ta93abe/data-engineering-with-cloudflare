{
  "name": "core",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-31",

  "containers": [
    {
      "class_name": "DbtContainer",
      "image": "./Dockerfile",
      "max_instances": 1
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "DBT_CONTAINER",
        "class_name": "DbtContainer"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DbtContainer"]
    }
  ],

  "r2_buckets": [
    {
      "binding": "DBT_ARTIFACTS",
      "bucket_name": "dbt-artifacts"
    }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
