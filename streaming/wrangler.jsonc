{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "streaming",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],

  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "pipelines": [
    {
      "pipeline": "6592c325ce2a4bc388840c1ea1eedeeb",
      "binding": "STREAM"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "LINEAR_WEBHOOK_SECRET",
      "store_id": "16dbae494da74139a51c1b15d7a7e6d1",
      "secret_name": "LINEAR_WEBHOOK_SECRET"
    }
  ]
}
