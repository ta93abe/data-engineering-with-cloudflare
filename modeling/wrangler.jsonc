{
  "name": "modeling",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-31",
  "compatibility_flags": ["nodejs_compat"],

  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic",
      "rollout_active_grace_period": 600
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "Sandbox",
        "class_name": "Sandbox"
      }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DbtContainer"] },
    { "tag": "v2", "new_sqlite_classes": ["JobRegistry"] },
    {
      "tag": "v3",
      "deleted_classes": ["DbtContainer", "JobRegistry"],
      "new_sqlite_classes": ["Sandbox"]
    }
  ],

  "workflows": [
    {
      "binding": "DBT_BUILD_WORKFLOW",
      "name": "dbt-build",
      "class_name": "DbtBuildWorkflow"
    }
  ],

  "triggers": {
    // Sunday 18:00 UTC = Monday 03:00 JST (weekly cadence).
    // Named day-of-week (SUN) because Cloudflare's cron parser
    // rejects numeric 0 and uses 1-based indexing (1=SUN..7=SAT)
    // which is easy to get wrong; the name is unambiguous.
    "crons": ["0 18 * * SUN"]
  },

  "r2_buckets": [
    {
      "binding": "DBT_ARTIFACTS",
      "bucket_name": "dbt-artifacts-modeling"
    }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
