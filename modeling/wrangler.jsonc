{
  "name": "modeling",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-31",

  "containers": [
    {
      "class_name": "DbtContainer",
      "image": "./Dockerfile",
      "max_instances": 1
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "DBT_CONTAINER",
        "class_name": "DbtContainer"
      },
      {
        "name": "JOB_REGISTRY",
        "class_name": "JobRegistry"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DbtContainer"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["JobRegistry"]
    }
  ],

  "workflows": [
    {
      "binding": "DBT_BUILD_WORKFLOW",
      "name": "dbt-build",
      "class_name": "DbtBuildWorkflow"
    }
  ],

  "triggers": {
    "crons": ["0 18 * * *"]
  },

  "r2_buckets": [
    {
      "binding": "DBT_ARTIFACTS",
      "bucket_name": "dbt-artifacts-modeling"
    }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
