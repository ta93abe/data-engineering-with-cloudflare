{
	"compatibility_date": "2025-04-01",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "data-catalog",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"r2_buckets": [
		{
			"binding": "DBT_ARTIFACTS",
			"bucket_name": "dbt-artifacts-modeling"
		}
	]
}
