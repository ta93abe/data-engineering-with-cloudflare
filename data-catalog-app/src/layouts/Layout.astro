---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "Data Catalog" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-kumo-base text-kumo-default min-h-screen">
		<slot />
	</body>
</html>
