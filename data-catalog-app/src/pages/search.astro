---
import Layout from "../layouts/Layout.astro";
import { AppShell } from "../components/AppSidebar";
---

<Layout title="Search — Data Catalog">
  <AppShell client:load>
    <div id="search-container" style="height: calc(100vh - 3rem);"></div>
  </AppShell>
</Layout>

<script>
  import "@cloudflare/ai-search-snippet";

  const container = document.getElementById("search-container");
  if (container) {
    const snippet = document.createElement("chat-page-snippet");
    snippet.setAttribute("api-url", "https://f36e9790-6644-4d7d-a660-8931e31e9188.search.ai.cloudflare.com");
    snippet.setAttribute("placeholder", "データカタログについて質問してください...");
    snippet.setAttribute("theme", "auto");
    container.appendChild(snippet);
  }
</script>
